    {
      "parameters": {
        "jsCode": "let seenLinks = [];\nconst rssItems = [];\n\nfor (const item of items) {\n  if (item.json.__type === 'seenLinksData') {\n    seenLinks = Array.isArray(item.json.seenLinks)\n      ? item.json.seenLinks\n      : [];\n  } else {\n    rssItems.push(item);\n  }\n}\n\nconst seenSet = new Set(\n  seenLinks.map(link => String(link).trim()).filter(Boolean)\n);\n\nconst newItems = [];\n\nfor (const item of rssItems) {\n  const link = String(item.json.link || item.json.guid || '').trim();\n\n  if (!link || seenSet.has(link)) continue;\n\n  seenSet.add(link);\n\n  newItems.push({\n    link,\n    title: item.json.title || 'Untitled',\n    pubDate: item.json.pubDate || item.json.isoDate || '',\n  });\n}\n\nnewItems.sort((a, b) => {\n  const dateA = new Date(a.pubDate || 0).getTime();\n  const dateB = new Date(b.pubDate || 0).getTime();\n  return dateB - dateA;\n});\n\n// Stop the workflow here when there are no new links.\nif (newItems.length === 0) {\n  return [];\n}\n\nconst savedAt = new Date().toISOString();\n\nconst appendText = `\\n\\n--- Security Digest ${savedAt} ---\\n` +\n  newItems.map((item, index) =>\n    `${index + 1}. ${item.title}\\n${item.link}\\n${item.pubDate || ''}`\n  ).join('\\n\\n') +\n  '\\n';\n\nreturn [{\n  json: {\n    newItems,\n    appendText,\n  },\n}];"
      },
