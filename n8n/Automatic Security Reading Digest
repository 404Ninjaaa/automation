        "jsCode": "const newItems = $('Filter & Prepare').first().json.newItems || [];\n\nif (newItems.length === 0) {\n  return [];\n}\n\nconst header = `📚 Security Reading Digest — ${new Date().toDateString()}\\n${newItems.length} new post(s)\\n\\n`;\n\nconst entries = newItems.map((item, index) => {\n  const title = item.title || 'Untitled';\n  const link = item.link || '';\n  return `${index + 1}. ${title}\\n${link}\\n\\n`;\n});\n\nconst maxLength = 1900;\nconst chunks = [];\nlet current = header;\n\nfor (const entry of entries) {\n  if ((current + entry).length > maxLength) {\n    if (current.trim()) chunks.push(current);\n    current = entry;\n  } else {\n    current += entry;\n  }\n}\n\nif (current.trim()) chunks.push(current);\n\nreturn chunks.map((message, index) => ({\n  json: {\n    message: chunks.length > 1\n      ? `${message}(part ${index + 1}/${chunks.length})`\n      : message,\n  },\n}));"
