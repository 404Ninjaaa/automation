      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet seenKeys = new Set();\nlet programs = [];\n\nfor (const item of items) {\n  const data = item.json;\n\n  // Seen-program data from Google Sheets\n  if (data.__type === 'seenKeysData') {\n    if (Array.isArray(data.seenKeys)) {\n      seenKeys = new Set(\n        data.seenKeys\n          .map(k => String(k).trim())\n          .filter(Boolean)\n      );\n    }\n    continue;\n  }\n\n  // Program\n  if (data.platform && data.url) {\n    const platform = String(data.platform).trim();\n    const url = String(data.url).trim();\n\n    programs.push({\n      ...data,\n      platform,\n      url,\n      key: `${platform}:${url}`,\n    });\n  }\n}\n\n// Remove duplicates from source itself\nconst uniquePrograms = [];\nconst sourceKeys = new Set();\n\nfor (const program of programs) {\n  if (!sourceKeys.has(program.key)) {\n    sourceKeys.add(program.key);\n    uniquePrograms.push(program);\n  }\n}\n\n// Remove programs already in Google Sheets\nconst newItems = uniquePrograms.filter(\n  program => !seenKeys.has(program.key)\n);\n\nreturn [{\n  json: {\n    newItems,\n    count: newItems.length,\n    totalPrograms: uniquePrograms.length,\n    alreadySeen: uniquePrograms.length - newItems.length,\n  }\n}];"
      },
