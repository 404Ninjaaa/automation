    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet seenLinks = [];\nconst jobs = [];\n\nfor (const item of items) {\n  const data = item.json || {};\n\n  if (data.__type === 'seenLinksData') {\n    seenLinks.push(...(Array.isArray(data.seenLinks) ? data.seenLinks : []));\n    continue;\n  }\n\n  if (data.link) {\n    jobs.push(data);\n  }\n}\n\nfunction normalizeUrl(url) {\n  return String(url || '')\n    .trim()\n    .replace(/[?#].*$/, '')\n    .replace(/\\/+$/, '')\n    .toLowerCase();\n}\n\nconst seenSet = new Set(seenLinks.map(normalizeUrl));\nconst currentRunSet = new Set();\nconst newJobs = [];\n\nfor (const job of jobs) {\n  const normalizedUrl = normalizeUrl(job.link);\n\n  if (!normalizedUrl) continue;\n  if (seenSet.has(normalizedUrl)) continue;\n  if (currentRunSet.has(normalizedUrl)) continue;\n\n  currentRunSet.add(normalizedUrl);\n\n  newJobs.push({\n    json: {\n      ...job,\n      normalizedUrl,\n      isNew: true\n    }\n  });\n}\n\nreturn newJobs;"
      },
