    {
      "parameters": {
        "jsCode": "const output = [];\n\nfor (const item of $input.all()) {\n  const results = Array.isArray(item.json.organic_results)\n    ? item.json.organic_results\n    : [];\n\n  for (const r of results) {\n    if (!r.link) continue;\n\n    const url = String(r.link).toLowerCase();\n\n    let source = 'Unknown';\n\n    if (url.includes('merojob.com')) source = 'Merojob';\n    else if (url.includes('jobsnepal.com')) source = 'JobsNepal';\n    else if (url.includes('kumarijob.com')) source = 'KumariJob';\n    else if (url.includes('froxjob.com')) source = 'FroxJob';\n    else if (url.includes('sathijob.com')) source = 'SathiJob';\n    else continue;\n\n    output.push({\n      json: {\n        position: r.position || null,\n        title: r.title || '',\n        link: r.link || '',\n        snippet: r.snippet || '',\n        date: r.date || '',\n        displayed_link: r.displayed_link || '',\n        source\n      }\n    });\n  }\n}\n\nreturn output;"
      },
