        "jsCode": "const text = String($json.content || '');\n\nconst urls = text.match(/https?:\\/\\/[^\\s<>\"'\\]\\[{}()]+/g) || [];\n\nfunction normalizeUrl(url) {\n  return String(url || '')\n    .trim()\n    .replace(/[.,;:!?]+$/, '')\n    .replace(/[?#].*$/, '')\n    .replace(/\\/+$/, '')\n    .toLowerCase();\n}\n\nconst seenLinks = [...new Set(\n  urls\n    .map(normalizeUrl)\n    .filter(url => url && /https?:\\/\\/(www\\.)?(merojob|jobsnepal|kumarijob|froxjob|sathijob)\\.com/.test(url))\n)];\n\nreturn [\n  {\n    json: {\n      __type: 'seenLinksData',\n      seenLinks,\n      seenCount: seenLinks.length\n    }\n  }\n];"
