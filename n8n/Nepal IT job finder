        "jsCode": "const jobs = $input.all();\n\nif (!jobs.length) {\n  return [];\n}\n\nconst lines = jobs.map((item, index) => {\n  const j = item.json || {};\n\n  return [\n    `--- JOB ${index + 1} ---`,\n    `Title: ${j.title || 'Unknown'}`,\n    `URL: ${j.link || ''}`,\n    `Source: ${j.source || 'Unknown'}`,\n    `Posted: ${j.date || 'Date not shown by Google'}`,\n    `Country: Nepal`,\n    `Description: ${j.snippet || ''}`,\n    `Saved: ${new Date().toISOString()}`\n  ].join('\\n');\n});\n\nreturn [\n  {\n    json: {\n      appendText: '\\n\\n' + lines.join('\\n\\n')\n    }\n  }\n];"
