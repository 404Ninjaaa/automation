        "jsCode": "// Edit these two lists to control coverage.\n// areas x keywords = total number of Text Search calls.\nconst areas = [\n  \"Kathmandu, Nepal\",\n  \"Pokhara, Nepal\",\n  \"Chitwan, Nepal\",\n  \"Lalitpur, Nepal\",\n  \"Bhaktapur, Nepal\",\n  \"Lumbini, Nepal\",\n  \"Bandipur, Nepal\",\n  \"Nagarkot, Nepal\",\n  \"Dharan, Nepal\",\n  \"Butwal, Nepal\",\n  \"Biratnagar, Nepal\",\n  \"Ilam, Nepal\"\n];\n\nconst keywords = [\n  \"tour operator\",\n  \"trekking agency\",\n  \"travel agency\"\n];\n\nconst items = [];\nfor (const area of areas) {\n  for (const kw of keywords) {\n    items.push({ json: { query: `${kw} in ${area}` } });\n  }\n}\nreturn items;"
